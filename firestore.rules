rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // AUTHENTICATION & AUTHORIZATION HELPERS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'Administrator';
    }

    function isManager() {
      return isAuthenticated() && (getUserRole() == 'Administrator' || getUserRole() == 'Manager');
    }

    function isOperator() {
      return isAuthenticated() && (
        getUserRole() == 'Administrator' ||
        getUserRole() == 'Manager' ||
        getUserRole() == 'Operator' ||
        getUserRole() == 'Cashier' ||
        getUserRole() == 'Sales Agent'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val) {
      return val is string && val.size() > 0;
    }

    function isValidNumber(val) {
      return val is number && !val.isNaN();
    }

    function isValidTimestamp(val) {
      return val is timestamp || val is string;
    }

    // =========================================================================
    // AUDIT FIELD VALIDATION
    // =========================================================================
    function hasValidAuditFields() {
      return request.resource.data.keys().hasAll(['createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'createdBy']);
    }

    // =========================================================================
    // SECTION A: SENSITIVE ENTERPRISE COLLECTIONS (Admin/Manager ONLY)
    // =========================================================================

    // 1. Settings Collection
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // 1b. Branches Collection
    match /branches/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // 1c. Branch Stocks Collection
    match /branch_stocks/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperator()
        && isValidString(request.resource.data.branchId)
        && isValidString(request.resource.data.productId)
        && isValidNumber(request.resource.data.stock)
        && request.resource.data.stock >= 0;
      allow delete: if isManager();
    }

    // 2. Account Heads Collection
    match /accountHeads/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // 3. Employees Collection
    match /employees/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isManager()
        && isValidString(request.resource.data.name)
        && isValidString(request.resource.data.designation)
        && isValidNumber(request.resource.data.salary)
        && request.resource.data.salary >= 0;
      allow delete: if isAdmin();
    }

    // 4. Loan Accounts Collection
    match /loanAccounts/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // 5. Transactions Collection
    match /transactions/{docId} {
      allow read: if isAuthenticated();
      allow create: if isOperator()
        && isValidString(request.resource.data.date)
        && isValidString(request.resource.data.description)
        && isValidNumber(request.resource.data.amount)
        && request.resource.data.amount >= 0
        && isValidString(request.resource.data.accountId);
      allow update, delete: if isManager();
    }

    // 6. Bank Accounts Collection
    match /bankAccounts/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // 7. Suppliers Collection
    match /suppliers/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperator()
        && isValidString(request.resource.data.name)
        && isValidNumber(request.resource.data.outstandingBalance);
      allow delete: if isManager();
    }

    // 8. Purchase Orders (PO) Collection
    match /purchaseOrders/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperator()
        && isValidString(request.resource.data.poNo)
        && isValidString(request.resource.data.supplierId)
        && isValidNumber(request.resource.data.total)
        && request.resource.data.total >= 0;
      allow delete: if isManager();
    }

    // 9. Attendances Collection
    match /attendances/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperator()
        && isValidString(request.resource.data.employeeId)
        && isValidString(request.resource.data.date)
        && isValidString(request.resource.data.status);
      allow delete: if isManager();
    }

    // 10. Users Collection
    match /users/{uid} {
      allow read: if isAuthenticated() && (isOwner(uid) || isManager());
      allow create: if isAuthenticated() && isOwner(uid)
        && isValidString(request.resource.data.role)
        && isValidString(request.resource.data.email);
      allow update: if isAuthenticated() && (isOwner(uid) || isManager());
      allow delete: if isAdmin();
    }

    // =========================================================================
    // SECTION B: KEY OPERATIONAL COLLECTIONS (All Authenticated Staff)
    // =========================================================================

    // 11. Invoices (POS Checkout) Collection
    match /invoices/{docId} {
      allow read: if isAuthenticated();
      allow create: if isOperator()
        && isValidString(request.resource.data.invoiceNo)
        && isValidString(request.resource.data.customerId)
        && isValidNumber(request.resource.data.total)
        && request.resource.data.total >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update: if isOperator();
      allow delete: if isManager();
    }

    // 12. Customers Collection
    match /customers/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperator()
        && isValidString(request.resource.data.name)
        && isValidNumber(request.resource.data.outstandingBalance);
      allow delete: if isManager();
    }

    // 13. Products Collection
    match /products/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperator()
        && isValidString(request.resource.data.name)
        && isValidString(request.resource.data.sku)
        && isValidNumber(request.resource.data.price)
        && request.resource.data.price >= 0
        && isValidNumber(request.resource.data.cost)
        && request.resource.data.cost >= 0
        && isValidNumber(request.resource.data.stock)
        && request.resource.data.stock >= 0;
      allow delete: if isManager();
    }

    // =========================================================================
    // SECTION B.2: EXTENDED ENTERPRISE SUBSYSTEM COLLECTIONS
    // =========================================================================

    // Manufacturing Subsystem
    match /boms/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /workcenters/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /productionOrders/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /qualityInspections/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Projects Subsystem
    match /projects/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /projectTasks/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /projectMilestones/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /projectTimesheets/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Service Subsystem
    match /serviceTechnicians/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /serviceAmcs/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /serviceWarranties/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /serviceRepairs/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /serviceComplaints/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Documents Subsystem
    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /docContracts/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Reports Subsystem
    match /gridReports/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /rdlTemplates/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Workflow Subsystem
    match /wfRules/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /wfAutomations/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /wfPending/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Integration Subsystem
    match /integrationsWebhooks/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /integrationsApps/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /integrationGithub/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /integrationGithubLogs/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // CRM Subsystem
    match /leads/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /campaigns/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }
    match /crmActivities/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // Fixed Assets Subsystem
    match /assets/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOperator();
    }

    // =========================================================================
    // SECTION B.3: ERROR LOGS & DIAGNOSTICS COLLECTION
    // =========================================================================
    match /error_logs/{docId} {
      allow create: if isAuthenticated();
      allow read, delete: if isAdmin();
    }

    // =========================================================================
    // SECTION B.4: AUDIT LOGS COLLECTION
    // =========================================================================
    match /audit_logs/{docId} {
      allow create: if isAuthenticated();
      allow read: if isManager();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // SECTION C: FALLBACK SAFETY NET
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
